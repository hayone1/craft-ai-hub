# The https address people open (TLS in front of port 8080).
HUB_ORIGIN=https://craft.example.org
# openssl rand -hex 24 (also signs the sign-in session)
MCP_KEY=
# Your OpenID Connect provider; register <HUB_ORIGIN>/_storage/callback as the redirect URI.
AUTH_NAME=Example
OIDC_ISSUER_URL=https://accounts.example.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
# The bucket. S3_ENDPOINT is empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com for R2.
STORAGE_NAME=Cloud
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# JSON list of shared folders: name, prefix, optional groups and readOnly.
STORAGE_SHARED=[{"name":"Team","prefix":"team/"},{"name":"Brand assets","prefix":"brand/","readOnly":true}]
# personal | shared | both | off (see the README)
CHAT_TOKENS=personal
CLAUDE_CODE_OAUTH_TOKEN=
