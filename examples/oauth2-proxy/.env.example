# The https address people open (TLS in front of oauth2-proxy's port 4180).
HUB_ORIGIN=https://craft.example.org
# Your OpenID Connect provider and the client registered for this hub.
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may sign in: an email domain, or * for anyone the provider signs in.
ALLOWED_EMAIL_DOMAINS=*
# openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=
# openssl rand -hex 24
MCP_KEY=
# Chat runs on Claude subscription tokens from `claude setup-token`.
# personal: everyone adds their own in the overlay's Account tab. shared: everyone uses
# CLAUDE_CODE_OAUTH_TOKEN. both: their own if added, else the shared one. off: no chat.
CHAT_TOKENS=personal
CLAUDE_CODE_OAUTH_TOKEN=
