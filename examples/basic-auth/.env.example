# openssl rand -hex 24
MCP_KEY=
# One or more user:password pairs, comma separated.
BASIC_AUTH=me:change-me
# Chat runs on Claude subscription tokens from `claude setup-token`.
# personal: everyone adds their own in the overlay's Account tab. shared: everyone uses
# CLAUDE_CODE_OAUTH_TOKEN. both: their own if added, else the shared one. off: no chat.
CHAT_TOKENS=personal
CLAUDE_CODE_OAUTH_TOKEN=
# The address people open, when it isn't http://localhost:8080.
HUB_ORIGIN=http://localhost:8080
