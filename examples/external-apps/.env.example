# The apps, as name=url pairs. Use the hayone/<app>:remote images for the assistant.
#   docker run -d -p 4101:8080 hayone/photocraft:remote
APPS=photocraft=http://host.docker.internal:4101,vectorcraft=http://host.docker.internal:4102,lightcraft=http://10.0.0.5:8080
# openssl rand -hex 24
MCP_KEY=
# Optional: user:password pairs. Leave empty only on a private network.
BASIC_AUTH=
# The address people open, when it isn't http://localhost:8080.
HUB_ORIGIN=http://localhost:8080
# personal | shared | both | off (see the README)
CHAT_TOKENS=personal
CLAUDE_CODE_OAUTH_TOKEN=
